# ==============================================================================
# Factory Memory - Environment Configuration Template
# Copy this file to '.env' and provide your actual API keys and local paths.
# DO NOT commit the actual '.env' file to version control.
# ==============================================================================

# LLM & API Configuration
LLM_PROVIDER=gemini                             # Options: gemini, openai
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite              # Recommended: gemini-3.5-flash-lite (fast, low latency)
GEMINI_THINKING=minimal                         # Options: minimal, off, low, default
GEMINI_TIMEOUT_S=60                             # API request timeout in seconds
# Optional Per-Agent Model Overrides (e.g. stronger model for safety verification)
GEMINI_MODEL_SAFETY=                            # Optional override for SafetyAgent (defaults to GEMINI_MODEL)
GEMINI_THINKING_SAFETY=                         # Optional override for SafetyAgent thinking (defaults to GEMINI_THINKING)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here  # Optional alternative LLM provider

# LLM Models
PRIMARY_LLM_MODEL=gpt-4o-mini
REASONING_LLM_MODEL=gpt-4o
TEMPERATURE=0.0

# Speech-to-Text (Whisper Local Inference)
WHISPER_MODEL=base          # Options: tiny, base, small, medium, large-v3
WHISPER_DEVICE=cpu          # Options: cpu, cuda

# Embeddings & Vector Search
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma_db
FAISS_INDEX_PATH=./data/faiss_index
# Where the knowledge store and downloaded models live (project/store/embeddings.py).
# Unset = .factory_memory/ in the repo (git-ignored). Set it in your shell or user
# environment, e.g. to put the store on another drive:
# FACTORY_MEMORY_STORAGE=E:/factory-memory-data

# Relational & Graph Storage
SQLITE_DB_PATH=./data/factory_memory.db
GRAPH_STORE_PATH=./data/knowledge_graph.graphml

# Execution & Safety Parameters
SAFETY_MAX_REVISION_LOOPS=2
CONFIDENCE_THRESHOLD_REVIEW=0.75
ABSTENTION_SIMILARITY_THRESHOLD=0.55

# Logging & Observability
LOG_LEVEL=INFO
AUDIT_LOG_PATH=./logs/audit_trace.jsonl
